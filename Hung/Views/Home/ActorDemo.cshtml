@{
    ViewData["Title"] = "Demo - Sử dụng vòng lặp, lệnh if-else";

    // Tạo danh sách dữ liệu Actor
    var actors = new List<dynamic>
    {
        new { Name = "Phương Anh Đào", Height = 160, Role = "Mai" },
        new { Name = "Tuấn Trần", Height = 170, Role = "Dương (Sâu)" },
        new { Name = "Trần Thành", Height = 150, Role = "Ông Hoàng" }
    };
}

<div class="container mt-5">
    <h2 class="mb-4" style="color: #333; font-weight: bold;">DEMO: Sử dụng vòng lặp, lệnh if-else</h2>

    <div class="row mt-4">
        <div class="col-md-8">
            <h4 class="mb-3">Danh sách diễn viên:</h4>
            <ul class="list-group">
                @foreach (var actor in actors)
                {
                    <li class="list-group-item">
                        <strong>@actor.Name</strong> - Chiều cao: @actor.Height cm - Vai diễn: 
                        @if (actor.Height >= 160)
                        {
                            <strong style="color: #00ff40;">@actor.Role</strong>
                        }
                        else
                        {
                            <span style="color: #00ff55;">@actor.Role</span>
                        }
                    </li>
                }
            </ul>
        </div>

        <div class="col-md-4">
            <div class="card" style="background-color: #f8f9fa; border: 1px solid #dee2e6;">
                <div class="card-header" style="background-color: #6366f1; color: white; font-weight: bold;">
                    Thống kê
                </div>
                <div class="card-body">
                    <p><strong>Tổng số diễn viên:</strong> @actors.Count</p>
                    <p><strong>Diễn viên cao >= 160cm:</strong> 
                        @{
                            var tallActors = actors.Where(a => a.Height >= 160).Count();
                        }
                        @tallActors
                    </p>
                    <p><strong>Chiều cao trung bình:</strong> @actors.Average(a => a.Height).ToString("F2") cm</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header" style="background-color: #6366f1; color: white;">
                    <h5 class="mb-0">Source Code Demo</h5>
                </div>
                <div class="card-body" style="background-color: #f5f5f5; font-family: 'Courier New', monospace; font-size: 13px; overflow-x: auto;">
                    <pre style="margin: 0; color: #fdf9f9;"><code>@Html.Raw(@"// Khai báo class Actor
public class Actor
{
    public string Name { get; set; }
    public int Height { get; set; }
    public string Role { get; set; }
}

// Tạo danh sách Actor
var actors = new List&lt;Actor&gt;
{
    new Actor { Name = ""Phương Anh Đào"", Height = 160, Role = ""Mai"" },
    new Actor { Name = ""Tuấn Trần"", Height = 170, Role = ""Dương (Sâu)"" },
    new Actor { Name = ""Trần Thành"", Height = 150, Role = ""Ông Hoàng"" }
};

// Vòng lặp foreach với if-else
@foreach (var actor in actors)
{
    &lt;li&gt;
        &lt;strong&gt;@actor.Name&lt;/strong&gt; - Chiều cao: @actor.Height cm - Vai diễn:
        @if (actor.Height >= 160)
        {
            &lt;strong&gt;@actor.Role&lt;/strong&gt;
        }
        else
        {
            &lt;span&gt;@actor.Role&lt;/span&gt;
        }
    &lt;/li&gt;
}")</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .container {
        background: white;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgb(7, 7, 7);
    }

    h2 {
        border-bottom: 3px solid #6366f1;
        padding-bottom: 10px;
    }

    .list-group-item {
        padding: 15px;
        border-left: 4px solid #6366f1;
        margin-bottom: 8px;
    }

    .card-header {
        font-weight: bold;
    }

    .card {
        box-shadow: 0 2px 4px rgb(5, 5, 5);
    }

    pre {
        background-color: #2d2d2d;
        color: #f8f8f2;
        padding: 15px;
        border-radius: 5px;
        overflow-x: auto;
        line-height: 1.5;
    }
</style>
