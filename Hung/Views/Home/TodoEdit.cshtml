@model Hung.Models.TodoItem

@{
    ViewData["Title"] = "Sửa công việc";
}

<div class="row justify-content-center">
    <div class="col-md-6 animate-fade-in">
        <div class="glass-card">
            <h2 class="mb-4 fw-bold" style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Sửa công việc
            </h2>

            <form asp-action="TodoEdit" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3">
                    <label asp-for="MaCongViec" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill"><i class="fas fa-hashtag text-primary"></i></span>
                        <input asp-for="MaCongViec" class="form-control border-start-0 rounded-end-pill" />
                    </div>
                    <span asp-validation-for="MaCongViec" class="text-danger small ms-3"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TenCongViec" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill"><i class="fas fa-tasks text-primary"></i></span>
                        <input asp-for="TenCongViec" class="form-control border-start-0 rounded-end-pill" />
                    </div>
                    <span asp-validation-for="TenCongViec" class="text-danger small ms-3"></span>
                </div>

                <div class="form-check form-switch mb-4 ms-2">
                    <input asp-for="TrangThaiHoanThanh" class="form-check-input" type="checkbox" role="switch">
                    <label asp-for="TrangThaiHoanThanh" class="form-check-label ms-2"></label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary-gradient flex-grow-1">
                        <i class="fas fa-check me-2"></i>Lưu thay đổi
                    </button>
                    <a asp-action="TodoList" class="btn btn-light rounded-pill px-4">
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
